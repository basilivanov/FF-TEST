{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feature-factory.local/schemas/artifact_manifest.schema.json",
  "title": "Artifact Manifest",
  "type": "object",
  "required": ["package_id", "files"],
  "additionalProperties": true,
  "properties": {
    "package_id": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": true,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" }
        }
      }
    },
    "dod": { "type": "array", "items": { "type": "string" } },
    "package_contract": {
      "type": "object",
      "required": ["package_id", "type"],
      "properties": {
        "package_id": { "type": "string" },
        "type": { "type": "string", "enum": ["backend", "frontend", "fullstack", "other"] }
      },
      "additionalProperties": true
    }
  }
}

