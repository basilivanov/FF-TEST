              "content": "{\n  \"task_id\": \"UI_AGENTS_DEPLOY_VERIFY_v1\",\n  \"role\": \"FrontOps\",\n  \"goal\": \"Страница Agents работает на реальном API с кэшем SWR; билд/деплой корректен; мок-данных нет.\",\n  \"stage0_context\": {\n    \"action\": \"GET /api/v1/context/?task_description=UI Agents deploy & verify\",\n    \"include_in_report\": [\"capsule_id\",\"capsule_version\",\"excerpt_200_400_chars\"],\n    \"fallbacks\": [\"если 404 — сверка /openapi.json и локальный 127.0.0.1:8081\"]\n  },\n  \"inputs_contracts\": {\n    \"api\": [\n      \"GET /api/v1/agents/status?fresh=0|1\",\n      \"POST /api/v1/agents/refresh\"\n    ],\n    \"ui_entry\": \"https://etl-tst.chococraft.ru/admin/agents (Basic Auth)\",\n    \"wrappers_hint\": \"скрипты деплоя/сборки и пути получи из контекста ('ff-ui-deploy-safe' и пр.), запуск — без sudo\",\n    \"secrets_hint\": \"BasicAuth для админки возьми из хранилища секретов/Кортекса (не хардкодить в коде/логе)\"\n  },\n  \"what_to_do\": [\n    \"Построить UI и подготовить релизный dist.\",\n    \"Задеплоить UI штатной обёрткой из контекста.\",\n    \"Проверить, что страница /admin/agents отдается и React-приложение инициализируется (см. пруфы ниже).\",\n    \"Проверить связку UI→API: status (fresh=0 и fresh=1) и кнопка 'Обновить'.\",\n    \"Убедиться в отсутствии мок-текста и мок-флагов в итоговом бандле.\"\n  ],\n  \"proof_pack\": {\n    \"required\": [\n      \"context_excerpt (источник + выдержка)\",\n      \"build_artifacts: список файлов dist с хэшами (index.html, assets/*hash*.js|css)\",\n      \"network_ok: успешный запрос UI→GET /api/v1/agents/status (200), затем POST /api/v1/agents/refresh и повторный GET с обновлённым as_of\",\n      \"ui_alive: скриншот страницы /admin/agents после входа по Basic Auth (видны карточки агентов, бейдж 'as of', цвета статуса)\",\n      \"no_mocks: подтверждение, что строка 'loaded with mock data' отсутствует в финальных JS/CSS; флаги VITE_*_MOCKS=false\",\n      \"perf_note: время ответа кэшированного GET /agents/status < 100 мс (по измерениям на стороне бэкенда/логов)\"\n    ],\n    \"nice_to_have\": [\n      \"консоль UI без ошибок (выскажи итог: errors=0|>0)\",\n      \"скрин 'до/после' на карточке любого агента после нажатия 'Обновить' (as_of изменился)\"\n    ]\n  },\n  \"report\": {\n    \"name\": \"REPORT_Agents_Cache_UI_Deploy_v1\",\n    \"shape\": {\n      \"env\": \"test\",\n      \"context_excerpt\": {\"source\":\"url\",\"capsule_id\":\"...\",\"capsule_version\":\"...\",\"snippet\":\"...\"},\n      \"build\": {\"dist_files\":[\"...\"], \"hashes_ok\": true, \"mock_strings_found\": 0},\n      \"api\": {\n        \"status_cached\": {\"http\":200,\"as_of\":\"...\",\"stale\":false,\"items_preview\":2},\n        \"status_fresh\": {\"http\":200,\"as_of_changed\": true},\n        \"refresh_call\": {\"accepted\": true}\n      },\n      \"ui_checks\": {\n        \"basic_auth\": \"ok\",\n        \"react_bootstrap\": \"ok|warn|fail\",\n        \"console_errors\": 0,\n        \"legend_present\": \"planned|present\"\n      },\n      \"sla\": {\"agents_status_cached_ms_p95\":\"<100\"},\n      \"screens\": [\"path_or_ref_screenshot_agents\"],\n      \"findings\": [\"кратко\"],\n      \"status\": \"green|yellow|red\",\n      \"next_steps\": [\"кратко\"]\n    }\n  },\n  \"dod\": [\n    \"UI /admin/agents доступен под Basic Auth; React инициализируется (видны карточки и 'as of').\",\n    \"GET /api/v1/agents/status (fresh=0) < 100 мс; fresh=1 возвращает обновлённый снимок (as_of меняется).\",\n    \"Мок-данных и мок-баннера нет.\",\n    \"Отчёт REPORT_Agents_Cache_UI_Deploy_v1 представлен одним сообщением с пруфами.\"\n  ],\n  \"guardrails\": [\n    \"не использовать sudo для сборки; запускать штатные обёртки из контекста\",\n    \"секреты получать из secret-store/Кортекса; не писать в логи\",\n    \"если React падает: приложить первую ошибку из консоли и минимальный root-cause\"\n  ],\n  \"risks\": [\n    \"Basic Auth недоступен агенту → приложи альтернативные пруфы (dist+assets+network к API) и отметь status='yellow'\",\n    \"кэш не обновляется из-за фоновой задачи → отрази в findings и status='yellow'\"\n  ]\n}\n"
