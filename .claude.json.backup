            "1": {
              "id": 1,
              "type": "text",
              "content": "# TASK: DOCS_SNAPSHOT_All_v1 — собрать ВСЮ рабочую документацию в один файл\n# ------------------------------------------------------------------------------\n# ЧТО ДЕЛАЕМ (человечески):\n# Собираем *все* MD/YML/YAML/JSON-конфиги/схемы и связанные текстовые доки из проекта\n# в ОДИН обзорный файл с оглавлением, метаданными и короткими выжимками содержимого.\n# Нужен как исходник для будущей капсулы SSoT и ревизии «что оставить/что удалить».\n#\n# ВАЖНО: Сначала тянем контекст через /context. Если контекст не получен — НЕ ПРОДОЛЖАТЬ.\n#\n# РЕЗУЛЬТАТ:\n#   /opt/feature-factory/reports/DOCS_SNAPSHOT_All_v1.md\n#   (один Markdown-файл со структурой: шапка → сводная таблица → TOC → секции по файлам)\n#\n# ДОП. ТРЕБОВАНИЯ:\n# - Без моков/синтетики. Только реальные файлы из репозитория/рабочих папок.\n# - Редакция секретов по шаблонам (см. REDACT_PATTERNS).\n# - Ограничение вывода контента: ≤ 400 строк или ≤ 40 КБ на файл (что первое).\n# - Большие артефакты (openapi.json и т.п.) — только верхняя часть + метаданные.\n# - Исключить приватные/секретные и бинарные файлы (см. EXCLUDES и MIME-фильтр).\n# - Для каждого файла: path, size, lines, sha256, mtime + короткий content preview.\n# - Все HTTP-пруфы (health/openapi/agents/logs/index/trace) приложить в конец отчёта\n#   в виде минимальных «body_head» + статусы, чтобы потом быстро верифицировать.\n#\n# ------------------------------------------------------------------------------\n# ЭТАП 0 — Гейт по контексту (обязательно)\nCTX_HEAD=\"$(/opt/feature-factory/bin/ff-context 'DOCS_SNAPSHOT_All_v1' | head -c 160 || true)\"\nif [ -z \"$CTX_HEAD\" ]; then\n  echo \"FATAL: /context не отвечает — прекращаю выполнение\"; exit 42\nfi\n\n# ------------------------------------------------------------------------------\n# ЭТАП 1 — Настройки и фильтры\nset -euo pipefail\nROOT=\"/opt/feature-factory\"\nOUT_DIR=\"$ROOT/reports\"\nOUT=\"$OUT_DIR/DOCS_SNAPSHOT_All_v1.md\"\nTMP=\"$(mktemp)\"\nmkdir -p \"$OUT_DIR\"\n\n# Файловые шаблоны, которые собираем\nINCLUDE_EXT='\n\\.md$\n\\.MD$\n\\.markdown$\n\\.yml$\n\\.yaml$\n\\.json$\n\\.toml$\n\\.ini$\n\\.cfg$\n\\.conf$\n\\.sql$\n\\.pyi?$       # схемы/скрипты конфигурации по проекту — аккуратно\n\\.env\\.example$\n'\n\n# Папки/файлы, которые исключаем из обхода\nEXCLUDES='\n/\\.git/\n/node_modules/\n/dist/\n/build/\n/.venv/\n/__pycache__/\n/\\.pytest_cache/\n/\\.mypy_cache/\n/\\.idea/\n/\\.vscode/\n/secrets?/\n/credentials?/\n/\\.htpasswd$\n/\\.env(\\.|$)\n/ssh/\n/\\.DS_Store$\n/\\.png$|\\.jpg$|\\.jpeg$|\\.gif$|\\.svg$|\\.ico$|\\.pdf$|\\.zip$|\\.tar(\\.gz)?$|\\.gz$|\\.xz$|\\.bin$\n'\n\n# Паттерны редакции (обезличивание секретов)\nREDACT_PATTERNS='\napi[_-]?key\\s*[:=]\\s*.* --> api_key: \"<REDACTED>\"\nsecret\\s*[:=]\\s*.*      --> secret: \"<REDACTED>\"\npassword\\s*[:=]\\s*.*    --> password: \"<REDACTED>\"\ntoken\\s*[:=]\\s*.*       --> token: \"<REDACTED>\"\nauthorization\\s*[:=]\\s*.* --> authorization: \"<REDACTED>\"\nclient[_-]?secret\\s*[:=]\\s*.* --> client_secret: \"<REDACTED>\"\n'\n\n# Ограничения вывода контента\nMAX_LINES=400\nMAX_BYTES=$((40*1024))\n\n# ------------------------------------------------------------------------------\n# ЭТАП 2 — Обнаружение файлов\n# Составляем список кандидатов по расширениям с исключениями\nfind \"$ROOT\" -type f \\\n  | grep -Ev \"$EXCLUDES\" \\\n  | grep -E \"$INCLUDE_EXT\" \\\n  | LC_ALL=C sort > \"$TMP.files\"\n\n# ------------------------------------------------------------------------------\n# ЭТАП 3 — Шапка отчёта\n{\n  echo \"# DOCS_SNAPSHOT_All_v1\"\n  echo\n  echo \"- generated_at: $(date -u +\"%Y-%m-%dT%H:%M:%SZ\")\"\n  echo \"- env: test\"\n  echo \"- root: $ROOT\"\n  echo \"- total_files_matched: $(wc -l < \"$TMP.files\")\"\n  echo\n  echo \"## Контекст (/api/v1/context HEAD)\"\n  echo\n  echo '```'\n  echo \"$CTX_HEAD\"\n  echo '```'\n  echo\n  echo \"## Сводная таблица\"\n  echo\n  echo \"| # | Path | Type | Size | Lines | SHA256 | mtime |\"\n  echo \"|---|------|------|------|-------|--------|-------|\"\n} > \"$OUT\"\n\n# ------------------------------------------------------------------------------\n# ЭТАП 4 — Метаданные и TOC\ni=0\n> \"$TMP.toc\"\n> \"$TMP.meta\"\nwhile IFS= read -r f; do\n  i=$((i+1))\n  [ -s \"$f\" ] || continue\n  # Тип по расширению\n  ext=\"${f##*.}\"\n  # Размер/строки/mtime/sha\n  size=\"$(wc -c < \"$f\" | tr -d ' ')\"\n  lines=\"$(wc -l < \"$f\" | tr -d ' ')\"\n  mtime=\"$(date -r \"$f\" +\"%Y-%m-%d %H:%M:%S %Z\")\"\n  sha=\"$(sha256sum \"$f\" | awk '{print $1}')\"\n  anchor=\"$(echo \"$f\" | tr '/. ' '---')\"\n\n  printf \"| %d | [%s](#%s) | %s | %s | %s | `%s` | %s |\\n\" \\\n    \"$i\" \"$f\" \"$anchor\" \"$ext\" \"$size\" \"$lines\" \"$sha\" \"$mtime\" >> \"$OUT\"\n\n  printf \"- [%s](#%s)\\n\" \"$f\" \"$anchor\" >> \"$TMP.toc\"\n  printf \"%s|%s|%s|%s|%s|%s|%s\\n\" \"$i\" \"$f\" \"$ext\" \"$size\" \"$lines\" \"$sha\" \"$mtime\" >> \"$TMP.meta\"\ndone < \"$TMP.files\"\n\n{\n  echo\n  echo \"## TOC (быстрые ссылки)\"\n  echo\n  cat \"$TMP.toc\"\n} >> \"$OUT\"\n\n# ------------------------------------------------------------------------------\n# ЭТАП 5 — Секции с контентом (редакция + лимиты)\nwhile IFS= read -r f; do\n  [ -s \"$f\" ] || continue\n  anchor=\"$(echo \"$f\" | tr '/. ' '---')\"\n  size=\"$(wc -c < \"$f\" | tr -d ' ')\"\n  lines=\"$(wc -l < \"$f\" | tr -d ' ')\"\n  sha=\"$(sha256sum \"$f\" | awk '{print $1}')\"\n  echo >> \"$OUT\"\n  echo \"### $f\" >> \"$OUT\"\n  echo \"<a id=\\\"$anchor\\\"></a>\" >> \"$OUT\"\n  echo \"\" >> \"$OUT\"\n  echo \"- size: ${size} bytes; lines: ${lines}; sha256: \\`$sha\\`\" >> \"$OUT\"\n  echo \"\" >> \"$OUT\"\n\n  # Выбор стратегии предпросмотра (большие файлы — сильно резать)\n  preview_bytes=$MAX_BYTES\n  preview_lines=$MAX_LINES\n  if echo \"$f\" | grep -qiE 'openapi|swagger'; then\n    preview_bytes=$((20*1024))\n    preview_lines=200\n  fi\n\n  # Чтение с лимитом\n  # shellcheck disable=SC2002\n  content=\"$(head -c \"$preview_bytes\" \"$f\" | head -n \"$preview_lines\")\"\n\n  # Редакция секретов\n  # Применяем упрощённую замену по ключевым словам\n  redacted=\"$content\"\n  redacted=\"$(printf \"%s\" \"$redacted\" | sed -E 's/(api[_-]?key\\s*[:=]\\s*).*/\\1\"<REDACTED>\"/I')\"\n  redacted=\"$(printf \"%s\" \"$redacted\" | sed -E 's/(secret\\s*[:=]\\s*).*/\\1\"<REDACTED>\"/I')\"\n  redacted=\"$(printf \"%s\" \"$redacted\" | sed -E 's/(password\\s*[:=]\\s*).*/\\1\"<REDACTED>\"/I')\"\n  redacted=\"$(printf \"%s\" \"$redacted\" | sed -E 's/(token\\s*[:=]\\s*).*/\\1\"<REDACTED>\"/I')\"\n  redacted=\"$(printf \"%s\" \"$redacted\" | sed -E 's/(authorization\\s*[:=]\\s*).*/\\1\"<REDACTED>\"/I')\"\n  redacted=\"$(printf \"%s\" \"$redacted\" | sed -E 's/(client[_-]?secret\\s*[:=]\\s*).*/\\1\"<REDACTED>\"/I')\"\n\n  echo '```' >> \"$OUT\"\n  printf \"%s\\n\" \"$redacted\" >> \"$OUT\"\n  echo '```' >> \"$OUT\"\n\n  # Пометка о тримминге\n  if [ \"$lines\" -gt \"$preview_lines\" ] || [ \"$size\" -gt \"$preview_bytes\" ]; then\n    echo \"> _Truncated for preview (showing up to ${preview_lines} lines or ${preview_bytes} bytes)._ \" >> \"$OUT\"\n  fi\ndone < \"$TMP.files\"\n\n# ------------------------------------------------------------------------------\n# ЭТАП 6 — Мини-пруфы HTTP-контракта (HEADS)\n{\n  echo\n  echo \"## Proof Pack (HTTP Heads)\"\n  echo\n  probe() { url=\"$1\"; printf \"- %s — \" \"$url\"; code=\"$(curl -ks -o /dev/null -w '%{http_code}' \"$url\")\"; printf \"%s\\n\" \"$code\"; head=\"$(curl -ks \"$url\" | head -c 120 | tr '\\n' ' ')\"; echo \"  body_head: \\`${head}\\`\"; }\n  probe \"https://etl-tst.chococraft.ru/openapi.json\"\n  probe \"https://etl-tst.chococraft.ru/api/v1/agents/status?fresh=0\"\n  probe \"https://etl-tst.chococraft.ru/api/v1/logs?limit=1\"\n  probe \"https://etl-tst.chococraft.ru/api/v1/index/calls?limit=1\"\n  probe \"https://etl-tst.chococraft.ru/api/v1/tasks/task_timeline_demo/trace?limit=1\"\n} >> \"$OUT\"\n\n# ------------------------------------------------------------------------------\n# ЭТАП 7 — Вывод короткого резюме на экран + путь к файлу\nprintf \"\\nDONE: %s\\n\" \"$OUT\"\nprintf \"files_total: %s\\n\" \"$(wc -l < \"$TMP.files\")\"\nprintf \"bytes_out: %s\\n\" \"$(wc -c < \"$OUT\")\"\n\n# ------------------------------------------------------------------------------\n# КРИТЕРИИ УСПЕХА (DoD)\n# - Файл $OUT существует и > 10 КБ.\n# - В шапке есть timestamp, total_files_matched.\n# - Сводная таблица содержит ≥ 20 строк (или равна числу найденных файлов).\n# - TOC кликабельно ведёт к секциям по якорям.\n# - Секций ≥ числу файлов (для пустых/отфильтрованных допускается меньше).\n# - В конце присутствует Proof Pack с кодами ответов (200/404/503 допускаются по факту).\n#\n# Что прислать в отчёт:\n#   REPORT_DOCS_SNAPSHOT_All_v1.json\n#   {\n#     \"env\":\"test\",\n#     \"out\":\".../DOCS_SNAPSHOT_All_v1.md\",\n#     \"files_total\": <int>,\n#     \"bytes_out\": <int>,\n#     \"sample_head\": \"<первые 120 байт>\",\n#     \"proofs\": [\n#       {\"url\": \"/openapi.json\", \"status\": <int>},\n#       {\"url\": \"/api/v1/agents/status?fresh=0\", \"status\": <int>},\n#       {\"url\": \"/api/v1/logs?limit=1\", \"status\": <int>},\n#       {\"url\": \"/api/v1/index/calls?limit=1\", \"status\": <int>},\n#       {\"url\": \"/api/v1/tasks/task_timeline_demo/trace?limit=1\", \"status\": <int>}\n#     ]\n#   }\n"
            }
          }
