#!/usr/bin/env bash
set -euo pipefail
unit="feature-factory-runner.service"
timeout="${1:-10}"
/usr/bin/systemctl daemon-reload >/dev/null || true
if /usr/bin/systemctl is-active --quiet "$unit"; then
  /usr/bin/systemctl restart "$unit"
else
  /usr/bin/systemctl start "$unit"
fi
for i in $(seq 1 "$timeout"); do
  if /usr/bin/systemctl is-active --quiet "$unit"; then
    echo "runner: ok"
    exit 0
  fi
  sleep 1
done
echo "runner: timeout"
exit 1

