# /etc/systemd/system/feature-factory-test.service
[Unit]
Description=Feature Factory Test Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/feature-factory
Environment=ENV=test
Environment=DRY_RUN=true
Environment=DATABASE_URL=sqlite:///./feature.test.db
ExecStart=/opt/feature-factory/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8081 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target