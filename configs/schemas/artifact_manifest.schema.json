{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Artifact Manifest Schema",
  "type": "object",
  "required": ["files", "package_contract"],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "package_contract": {
      "type": "object",
      "properties": {
        "package_id": { "type": "string" },
        "summary": { "type": "string" },
        "files_layout": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["package_id", "summary", "files_layout"],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}