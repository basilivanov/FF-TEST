{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pricing.reprice",
  "type": "object",
  "properties": {
    "type": {"const": "pricing.reprice"},
    "marketplaces": {"type": "array", "items": {"type": "string"}},
    "skus": {
      "type": "object",
      "properties": {
        "source": {"type": "string"},
        "locator": {"type": "string"}
      },
      "required": ["source", "locator"],
      "additionalProperties": true
    },
    "rules": {
      "type": "object",
      "properties": {
        "target": {"type": "string"}
      },
      "required": ["target"],
      "additionalProperties": true
    }
  },
  "required": ["type", "skus", "rules"],
  "additionalProperties": true
}

