    "destination": {
      "type": "object",
      "properties": {
        "kind": {"type": "string"},
        "target": {"type": "string"}
      },
      "required": ["kind", "target"],
      "additionalProperties": true
    }
  },
  "required": ["type", "provider", "operation", "period", "destination"],
  "additionalProperties": true
