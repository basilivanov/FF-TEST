{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "analytics.fetch",
  "type": "object",
  "properties": {
    "type": {"const": "analytics.fetch"},
    "metrics": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dimensions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "period": {
      "type": "object",
      "properties": {"preset": {"type": "string"}, "since": {"type": "string"}, "to": {"type": "string"}},
      "additionalProperties": true
    },
    "destination": {
      "type": "object",
      "properties": {"kind": {"type": "string"}, "target": {"type": "string"}},
      "required": ["kind", "target"],
      "additionalProperties": true
    }
  },
  "required": ["type", "metrics", "dimensions", "period", "destination"],
  "additionalProperties": true
}

