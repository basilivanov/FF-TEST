{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "payments.reports",
  "type": "object",
  "properties": {
    "type": {"const": "payments.reports"},
    "provider": {"type": "string"},
    "period": {
      "type": "object",
      "properties": {"preset": {"type": "string"}, "since": {"type": "string"}, "to": {"type": "string"}},
      "additionalProperties": true
    },
    "destination": {
      "type": "object",
      "properties": {"kind": {"type": "string"}, "target": {"type": "string"}},
      "required": ["kind", "target"],
      "additionalProperties": true
    }
  },
  "required": ["type", "provider", "period", "destination"],
  "additionalProperties": true
}

