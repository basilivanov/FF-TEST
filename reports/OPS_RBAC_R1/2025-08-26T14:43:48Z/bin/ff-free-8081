#!/usr/bin/env bash
set -euo pipefail
PORT=8081
SERVICE="feature-factory-test.service"
SERVICE_CGROUP="system.slice/${SERVICE}"
mapfile -t PIDS < <( ss -ltnp "sport = :${PORT}" \
  | awk 'NR>1{match($0,/pid=([0-9]+)/,m); if(m[1]!="") print m[1] }' | sort -u )
if (( ${#PIDS[@]} == 0 )); then echo "no listeners on :${PORT}"; exit 0; fi
echo "found PIDs on :${PORT}: ${PIDS[*]}"
for pid in "${PIDS[@]}"; do
  if [[ -r "/proc/${pid}/cgroup" ]] && grep -q "${SERVICE_CGROUP}" "/proc/${pid}/cgroup"; then
    echo "skip ${pid} (belongs to ${SERVICE})"; continue
  fi
  echo "TERM ${pid}"; kill -TERM "${pid}" 2>/dev/null || true
done
for i in {1..10}; do
  if ss -ltnp "sport = :${PORT}" | grep -q "pid="; then sleep 0.5; else echo "port ${PORT} is free"; exit 0; fi
done
echo "WARN: port still busy"; exit 1
