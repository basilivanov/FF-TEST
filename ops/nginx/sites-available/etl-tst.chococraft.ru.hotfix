server {
    listen 80;
    server_name etl-tst.chococraft.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
        default_type text/plain;
    }

    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name etl-tst.chococraft.ru;

    ssl_certificate /etc/letsencrypt/live/etl-tst.chococraft.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/etl-tst.chococraft.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=86400; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Редирект без завершающего слеша на /admin/
    location = /admin { return 301 /admin/; }

    # SPA под префиксом /admin/ (root, чтобы корректно резолвить /admin/index.html)
    location ^~ /admin/ {
        auth_basic "Admin Area";
        auth_basic_user_file /etc/nginx/.htpasswd;

        root /var/www/etl-tst.chococraft.ru;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    # Статика SPA под /admin/assets/ — публично, без BasicAuth, с долговечным кешем
    location ^~ /admin/assets/ {
        auth_basic off;
        root /var/www/etl-tst.chococraft.ru;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        types {
            text/css css;
            application/javascript js;
            application/json json;
            image/svg+xml svg;
            font/woff woff;
            font/woff2 woff2;
        }
        try_files $uri =404;
    }
    location = /admin/index.html {
        root /var/www/etl-tst.chococraft.ru;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
    }

    # Статика с долговечным кешем (публично, без BasicAuth)
    location ^~ /assets/ {
        alias /var/www/etl-tst.chococraft.ru/admin/assets/;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        types {
            text/css css;
            application/javascript js;
            application/json json;
            image/svg+xml svg;
            font/woff woff;
            font/woff2 woff2;
        }
    }

    # API-прокси (upstream фактически на 8081)
    location ^~ /api/ {
        auth_basic "Admin Area";
        auth_basic_user_file /etc/nginx/.htpasswd;
        # ВАЖНО: без завершающего "/" — сохраняем исходный путь (/api/v1/*)
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # SSE — отдельные настройки
    location = /api/v1/stream/events {
        auth_basic "Admin Area";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://127.0.0.1:8081/api/v1/stream/events;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        chunked_transfer_encoding on;
    }

    access_log /var/log/nginx/etl-tst.chococraft.ru.access.log combined;
    error_log  /var/log/nginx/etl-tst.chococraft.ru.error.log;
}
