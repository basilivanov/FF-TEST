{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "graph": {
      "type": "string",
      "const": "G1"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["NEW", "RUNNING", "DONE", "FAILED"]
          }
        },
        "required": ["name", "state"]
      }
    }
  },
  "required": ["run_id", "graph", "nodes"]
}