  "type": "object",
  "properties": {
    "nl_text": {
      "type": "string"
    },
    "intent_json": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
