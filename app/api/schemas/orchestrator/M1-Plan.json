{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "intent_json": {
      "type": "object"
    },
    "dag": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["job", "code", "doc", "test"]
          },
          "role": {
            "type": "string",
            "enum": ["Architect", "Dev", "QA", "Scribe"]
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "idempotency_key": {
            "type": "string"
          },
          "retry": {
            "type": "object",
            "properties": {
              "max": {
                "type": "integer"
              },
              "backoff": {
                "type": "string"
              }
            },
            "required": ["max", "backoff"]
          },
          "deadline": {
            "type": "string"
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dod": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "severity": {
            "type": "string",
            "enum": ["low", "med", "high"]
          }
        },
        "required": ["id", "name", "kind", "role", "preconditions", "postconditions", "idempotency_key", "retry", "deadline", "models", "outputs", "dod", "severity"]
      }
    },
    "package_contract": {
      "type": "object"
    }
  },
  "required": ["intent_json", "dag", "package_contract"]
}