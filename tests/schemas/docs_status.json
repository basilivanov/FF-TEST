{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DocStatusResponse": {
      "type": "object",
      "properties": {
        "doc_name": {
          "type": "string",
          "description": "Name of the document"
        },
        "version": {
          "type": "string", 
          "description": "Version of the document"
        },
        "content_hash": {
          "type": "string",
          "description": "MD5 hash of document content"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp"
        }
      },
      "required": ["doc_name", "version", "content_hash", "updated_at"],
      "additionalProperties": false
    },
    "DocsStatusResponse": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DocStatusResponse"
          }
        }
      },
      "required": ["docs"],
      "additionalProperties": false
    },
    "RebuildResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "error"]
        },
        "message": {
          "type": "string"
        },
        "docs_updated": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["status", "message", "docs_updated"],
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        }
      },
      "required": ["detail"],
      "additionalProperties": false
    }
  }
}